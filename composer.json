{
    "name": "postyou/contao-proven-expert",
    "description": "ProvenExpert API Integration for Contao",
    "type": "contao-bundle",
    "license": "LGPL-3.0+",
    "authors": [
        {
            "name": "POSTYOU Digital- & Filmagentur",
            "homepage": "https://www.postyou.de"
        }
    ],
    "support": {
        "issues": "https://github.com/postyou/contao-proven-expert/issues",
        "source": "https://github.com/postyou/contao-proven-expert"
    },
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.7",
        "doctrine/dbal": "^3.7 || ^4.3",
        "psr/log": "^3.0",
        "symfony/cache": "^7.4",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/http-client-contracts": "^3.1",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "contao/easy-coding-standard": "^7.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Postyou\\ContaoProvenExpert\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Postyou\\ContaoProvenExpert\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "composer/package-versions-deprecated": true,
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
